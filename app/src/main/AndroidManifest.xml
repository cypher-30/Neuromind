                android:resource="@xml/motivator_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.MiniQuickLogWidgetReceiver"
            android:label="@string/widget_mini_quick_log_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_quick_log_widget_info" />
        </receiver>

        <receiver
            android:name=".ui.widget.MiniStatusWidgetReceiver"
            android:label="@string/widget_mini_status_label"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mini_status_widget_info" />
        </receiver>

