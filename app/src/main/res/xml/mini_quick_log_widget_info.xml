<?xml version="1.0" encoding="utf-8"?>
<!-- previewImage: drawn by the widget-preview script so the picker shows what the
     widget looks like (OxygenOS's picker ignores previewLayout). Resizable widgets
     switch between compact / medium / wide layouts (SizeMode.Responsive). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="64dp"
    android:minHeight="64dp"
    android:targetCellWidth="1"
    android:targetCellHeight="1"
    android:resizeMode="none"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen|keyguard"
    android:description="@string/widget_mini_quick_log_description"
    android:previewImage="@drawable/widget_preview_quick_log"
    android:initialLayout="@layout/widget_getting_ready" />
