<?xml version="1.0" encoding="utf-8"?>
<!-- previewImage: drawn by the widget-preview script so the picker shows what the
     widget looks like (OxygenOS's picker ignores previewLayout). Resizable widgets
     switch between compact / medium / wide layouts (SizeMode.Responsive). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="180dp"
    android:minHeight="110dp"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:description="@string/widget_next_class_description"
    android:previewImage="@drawable/widget_preview_next_up"
    android:initialLayout="@layout/today_widget_initial" />
