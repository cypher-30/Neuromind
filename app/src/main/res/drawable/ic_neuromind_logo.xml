    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Brain silhouette -->
    <path
        android:fillColor="#33FFFFFF"
        android:strokeColor="#EEFFFFFF"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M 54,30 C 51,27 44,26 37,29 C 28,32 26,43 29,52 C 32,61 38,71 46,75 C 50,77 52,77 54,77 C 56,77 58,77 62,75 C 70,71 76,61 79,52 C 82,43 80,32 71,29 C 64,26 57,27 54,30 Z" />

