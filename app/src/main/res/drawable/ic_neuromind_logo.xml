<?xml version="1.0" encoding="utf-8"?>
<!--
  Neuromind brand mark, "Organic" design system: three circles — a large
  terracotta disc, an overlapping sage disc, and a small accent-light spark —
  on the cream splash background. Matches Neuromind.dc.html's splash SVG
  (viewBox 0 0 120 120) so it scales identically at any Compose size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Large terracotta disc -->
    <path
        android:fillColor="#C67139"
        android:pathData="M 55,58 m -40,0 a 40,40 0 1,0 80,0 a 40,40 0 1,0 -80,0 Z" />

    <!-- Overlapping sage disc -->
    <path
        android:fillColor="#7A8A5E"
        android:pathData="M 80,82 m -24,0 a 24,24 0 1,0 48,0 a 24,24 0 1,0 -48,0 Z" />

    <!-- Small accent-light spark -->
    <path
        android:fillColor="#FFC6A5"
        android:pathData="M 30,27 m -7,0 a 7,7 0 1,0 14,0 a 7,7 0 1,0 -14,0 Z" />

</vector>
