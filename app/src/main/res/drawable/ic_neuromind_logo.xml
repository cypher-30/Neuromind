<?xml version="1.0" encoding="utf-8"?>
<!--
  In-app Neuromind logo: brain + node neural-network mark on transparent background.
  White + WarmOrange — designed for use on the blue-gradient splash background.
  Viewport mirrors the launcher foreground so it scales identically at any Compose size.
-->
